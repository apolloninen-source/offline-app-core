-- The reader screen: contents -> a part's sections -> the text of a section.
--
-- Settings, in the app's game.project:
--   [reader]
--   book_dir = /shared/reader/data/      where the book's JSON lives
--   open = 3,281                         optional: open a part (and section) at start
--   background = #F3E9D2                 optional colours (hex)
--   ink = #2B1D12
--   accent = #8B2E16
--   muted = #7A6A58
--
-- Drag to scroll, tap to open. In the text, footnote numbers are shown as
-- superscripts; tapping a paragraph that has notes shows them. The Android
-- back key (or the ‹ link in the header) goes back up a level.
--
-- The reader remembers where the player stopped ("Continue" on the
-- contents) and keeps one growing list of marks, each with an optional
-- note (the player's own annotation):
--   * bookmarks: "Bookmark" in a section's header marks the paragraph at the
--     top of the screen; it gets a bar in the margin;
--   * highlights: press and hold a paragraph, tap its sentences, "Highlight";
--     they are tinted in the text.
-- Tapping a marked paragraph shows its note. The Marks page lists them all
-- in book order, filtered (all, highlights, bookmarks, with notes), to open,
-- annotate, share or remove, and exports them as a .txt file. Everything is
-- stored on the phone, in the app's save folder (reader.save_id, default
-- "reader"), in a file named "reader".
--
-- Long sections are cut into chunks at sentence ends, and only the chunks on
-- screen are drawn, so even the longest sections stay light on cheap phones.
--
-- Inside a game: set reader.start_hidden = 1 and open it with
--   msg.post("reader:/reader#gui", "open", { part = 3, section = 311 })
-- (or with no part for the contents). The sender becomes its owner: the
-- contents then get a "‹ Back" link, and going back from the contents (or
-- the "close" message) hides the reader and sends "reader_closed" to the
-- owner. While hidden it draws nothing and takes no input.

local reader = require "core.reader"
local text = require "core.reader_ui.text"
local save_mod = require "core.save"
local bookmarks = require "core.bookmarks"
local note_editor = require "core.ui.note_editor"
local notes_export = require "core.notes_export"
local ads = require "core.ads"
local share = require "core.share"

local TOUCH = hash("mouse_button_left")
local BACK = hash("key_back")
local WHEEL_UP = hash("mouse_wheel_up")
local WHEEL_DOWN = hash("mouse_wheel_down")

local MARGIN = 44
local HEADER_H = 170
local GAP = 22
local TAP_SLOP = 14
local HOLD = 0.5 -- seconds of press-and-hold that open the highlight picker

local function config_color(key, default)
	return text.color(sys.get_config_string("reader." .. key, default))
end

-- Layout ---------------------------------------------------------------------

-- Text size, measured with the font resource (Defold 1.13 has no
-- gui.get_text_metrics_from_node).
local function measure(self, font, str, width, leading, line_break)
	self.font_res[font] = self.font_res[font] or gui.get_font_resource(font)
	return resource.get_text_metrics(self.font_res[font], str,
		{ width = width, leading = leading or 1, line_break = line_break ~= false })
end

local function new_text(self, str, font, color, width, scale)
	local node = gui.new_text_node(vmath.vector3(0, 0, 0), str)
	gui.set_font(node, font)
	gui.set_pivot(node, gui.PIVOT_NW)
	gui.set_line_break(node, true)
	gui.set_size(node, vmath.vector3(width / (scale or 1), 0, 0))
	gui.set_color(node, color)
	gui.set_leading(node, 1.15)
	if scale then
		gui.set_scale(node, vmath.vector3(scale, scale, 1))
	end
	gui.set_parent(node, self.content)
	local metrics = measure(self, font, str, width / (scale or 1), 1.15)
	return node, metrics.height * (scale or 1)
end

-- Adds an item below the previous ones. on_tap is optional.
local function add(self, str, opts)
	opts = opts or {}
	local width = self.width - 2 * MARGIN - (opts.indent or 0)
	local node, h = new_text(self, str, opts.font or "body", opts.color or self.colors.ink, width, opts.scale)
	local top = -self.cursor - (opts.space_before or 0)
	gui.set_position(node, vmath.vector3(MARGIN + (opts.indent or 0), top, 0))
	local item = { node = node, top = top, height = h, on_tap = opts.on_tap }
	self.items[#self.items + 1] = item
	self.cursor = -top + h + (opts.space_after or GAP)
	return item
end

-- Adds a text on a tinted band (a highlight). Returns the item; its node is
-- the band, with the text inside.
local function add_highlighted(self, str, opts)
	opts = opts or {}
	local scale = opts.scale or 1
	local width = self.width - 2 * MARGIN
	local node, h = new_text(self, str, "body", opts.color or self.colors.ink, width, opts.scale)
	local top = -self.cursor - (opts.space_before or 0)
	local band = gui.new_box_node(vmath.vector3(MARGIN - 10, top + 5, 0), vmath.vector3(width + 20, h + 10, 0))
	gui.set_pivot(band, gui.PIVOT_NW)
	gui.set_color(band, self.colors.highlight)
	gui.set_parent(band, self.content)
	gui.set_parent(node, band)
	gui.set_position(node, vmath.vector3(10, -5, 0))
	gui.set_inherit_alpha(node, false)
	local item = { node = band, top = top, height = h, on_tap = opts.on_tap }
	self.items[#self.items + 1] = item
	self.cursor = -top + h + (opts.space_after or GAP)
	return item
end

-- Adds several short tappable labels on one line (filters, actions).
-- parts: { { label, on_tap, color } }. Returns their items.
local function add_inline(self, parts, opts)
	opts = opts or {}
	local scale = opts.scale or 1
	local top = -self.cursor - (opts.space_before or 0)
	local x, line_h, out = MARGIN, 0, {}
	for _, part in ipairs(parts) do
		local metrics = measure(self, "body", part[1], 0, 1, false)
		local node = gui.new_text_node(vmath.vector3(x, top, 0), part[1])
		gui.set_font(node, "body")
		gui.set_pivot(node, gui.PIVOT_NW)
		gui.set_color(node, part[3] or self.colors.accent)
		gui.set_scale(node, vmath.vector3(scale, scale, 1))
		gui.set_parent(node, self.content)
		local w, h = metrics.width * scale, metrics.height * scale
		local item = { node = node, top = top, height = h, on_tap = part[2], x0 = x - 14, x1 = x + w + 14 }
		self.items[#self.items + 1] = item
		out[#out + 1] = item
		x = x + w + (opts.gap or 40)
		line_h = math.max(line_h, h)
	end
	self.cursor = -top + line_h + (opts.space_after or GAP)
	return out
end

-- The text area: below the header, above the banner's space (if any).
local function viewport_h(self)
	return self.height - HEADER_H - (self.bottom or 0)
end

local function max_scroll(self)
	return math.max(0, self.cursor + 60 - viewport_h(self))
end

-- Shows only the items that are on screen (or nearly).
local function cull(self)
	local view = viewport_h(self)
	for _, item in ipairs(self.items) do
		local top = item.top + self.scroll -- 0 = top of viewport, negative = below
		local visible = top > -view - 400 and top - item.height < 400
		if visible ~= item.enabled then
			gui.set_enabled(item.node, visible)
			item.enabled = visible
		end
	end
end

-- "Top": shown once the page has scrolled more than a screen.
local function update_top_button(self)
	if self.top_btn then
		local show_it = self.scroll > viewport_h(self) and not self.notes_panel
		gui.set_enabled(self.top_btn, show_it)
		self.top_shown = show_it
	end
end

local function set_scroll(self, value)
	self.scroll = math.max(0, math.min(max_scroll(self), value))
	gui.set_position(self.content, vmath.vector3(0, self.height - HEADER_H + self.scroll, 0))
	cull(self)
	update_top_button(self)
end

-- Keeps the bottom free for the banner: an opaque band the text scrolls
-- under, exactly as high as the banner.
local function set_bottom(self, units)
	self.bottom = units
	gui.set_size(self.bottom_bg, vmath.vector3(self.width, units, 0))
	gui.set_position(self.bottom_bg, vmath.vector3(self.width / 2, units / 2, 0))
	gui.set_enabled(self.bottom_bg, units > 0)
	if self.content then
		set_scroll(self, self.scroll)
	end
end

-- The banner's height in screen pixels -> GUI units. The 720 x 1280 layout
-- is fitted into the window and centred, so any bar below it counts.
local function pixels_to_units(self, px)
	if px <= 0 then
		return 0
	end
	local w, h = window.get_size()
	local scale = math.min(w / self.width, h / self.height)
	local bar = (h - self.height * scale) / 2
	return math.max(0, px - bar) / scale + 4
end

-- The banner shows only while the text of a section is on screen.
local function update_banner(self)
	local on = self.visible and self.view == "section"
	if on then
		ads.show_banner()
	else
		ads.hide_banner()
	end
	if self.test_banner_px then
		set_bottom(self, on and pixels_to_units(self, self.test_banner_px) or 0)
	end
end

local function clear(self)
	if self.content then
		gui.delete_node(self.content)
	end
	self.content = gui.new_box_node(vmath.vector3(0, 0, 0), vmath.vector3(0, 0, 0))
	gui.set_parent(self.content, self.root)
	gui.move_below(self.content, self.header_bg)
	self.items = {}
	self.chunks = nil
	self.cursor = 24
	self.scroll = 0
	set_scroll(self, 0)
	update_banner(self) -- every view starts here, after setting self.view
end

local function set_header(self, back_label, title, action_label)
	gui.set_text(self.back, back_label and ("‹ " .. back_label) or "")
	gui.set_text(self.action, action_label or "")
	self.action_enabled = action_label ~= nil
	gui.set_text(self.title, title)
	-- Long titles shrink to fit on one line.
	gui.set_scale(self.title, vmath.vector3(1, 1, 1))
	local w = measure(self, "title", title, 0, 1, false).width
	local room = self.width - 2 * MARGIN - 84 -- the Top button's place
	if w > room then
		local s = room / w
		gui.set_scale(self.title, vmath.vector3(s, s, 1))
	end
	self.back_enabled = back_label ~= nil
end

-- Views ----------------------------------------------------------------------

local show_contents, show_part, show_section, show_marks

-- Where reading stands: the first paragraph (chunk) with a real part of it
-- still on screen (not just its last line).
local function current_chunk(self)
	for k, item in ipairs(self.chunks or {}) do
		if item.top - item.height < -self.scroll - math.min(90, item.height / 2) then
			return k
		end
	end
	return 1
end

-- Saves the reading position (in a section only).
local function remember(self)
	if self.view == "section" then
		bookmarks.set_last(self.store.values, self.part_n, self.section_n, current_chunk(self))
		self.store:write()
	end
end

local function close_notes(self)
	if self.notes_panel then
		gui.delete_node(self.notes_panel)
		self.notes_panel = nil
	end
end

local function show_notes(self, section, nums, mark)
	close_notes(self)
	local panel = gui.new_box_node(vmath.vector3(self.width / 2, self.height / 2, 0),
		vmath.vector3(self.width, self.height, 0))
	gui.set_color(panel, vmath.vector4(0, 0, 0, 0.55))
	gui.set_parent(panel, self.root)
	gui.set_inherit_alpha(panel, false)
	local body = {}
	for _, m in ipairs(mark and (mark[1] and mark or { mark }) or {}) do
		if (m.note or "") ~= "" then
			body[#body + 1] = "Your note: " .. m.note
		elseif bookmarks.kind(m) == "highlight" then
			body[#body + 1] = "Highlighted. Press and hold the paragraph to change it."
		else
			body[#body + 1] = "Bookmarked."
		end
	end
	for _, num in ipairs(nums or {}) do
		body[#body + 1] = text.superscript(num) .. " " .. (section.notes[num] or "")
	end
	local width = self.width - 2 * MARGIN - 40
	local node = gui.new_text_node(vmath.vector3(0, 0, 0), table.concat(body, "\n\n"))
	gui.set_font(node, "body")
	gui.set_line_break(node, true)
	gui.set_size(node, vmath.vector3(width, 0, 0))
	gui.set_leading(node, 1.15)
	gui.set_color(node, self.colors.ink)
	gui.set_inherit_alpha(node, false)
	local h = measure(self, "body", table.concat(body, "\n\n"), width, 1.15).height
	local card = gui.new_box_node(vmath.vector3(0, 0, 0), vmath.vector3(width + 60, h + 60, 0))
	gui.set_color(card, self.colors.background)
	gui.set_inherit_alpha(card, false)
	gui.set_parent(card, panel)
	gui.set_pivot(node, gui.PIVOT_NW)
	gui.set_position(node, vmath.vector3(-width / 2, h / 2, 0))
	gui.set_parent(node, card)
	self.notes_panel = panel
end

-- A bar in the margin beside a bookmarked paragraph.
local function mark_bar(self, item, height)
	local bar = gui.new_box_node(vmath.vector3(-18, 0, 0), vmath.vector3(5, height or item.height, 0))
	gui.set_pivot(bar, gui.PIVOT_N)
	gui.set_color(bar, self.colors.accent)
	gui.set_parent(bar, item.node)
	item.bar = bar
end

-- "Vana Parva · Aranya Parva · Section CCCXI"
local function place_of(self, part_n, section_n)
	local part = self.book:part(part_n)
	local section = part.sections[section_n]
	return part.name .. (section.sub and (" · " .. section.sub) or "") .. " · Section " .. section.label
end

-- Splits a chunk's sentences into runs: plain ones, and one per highlight.
local function runs_of(sentences, highlights)
	local runs = {}
	local i = 1
	while i <= #sentences do
		local mark = bookmarks.highlight_at(highlights, i)
		local j = i
		while j < #sentences and bookmarks.highlight_at(highlights, j + 1) == mark do
			j = j + 1
		end
		runs[#runs + 1] = { from = i, to = j, mark = mark }
		i = j + 1
	end
	return runs
end

show_section = function(self, part_n, section_n, chunk)
	close_notes(self)
	local part = self.book:part(part_n)
	local section = part.sections[section_n]
	self.view, self.part_n, self.section_n = "section", part_n, section_n
	clear(self)
	set_header(self, part.name, "Section " .. section.label, "Bookmark")
	local st = self.store.values
	if not st.highlight_tip_seen then
		add(self, "Tip: press and hold a paragraph to highlight sentences.", { color = self.colors.muted,
			scale = 0.8, space_after = 14 })
	end
	if section.sub then
		add(self, section.sub, { color = self.colors.muted, space_after = GAP + 6 })
	end
	local marks = bookmarks.in_section(st, part_n, section_n)
	local highlights = bookmarks.highlights_in(st, part_n, section_n)
	local n = 0
	self.chunks = {}
	for _, para in ipairs(section.paras) do
		local pieces = text.chunks(para, 700)
		for i, piece in ipairs(pieces) do
			n = n + 1
			local k = n
			local sentences = text.sentences(piece)
			local runs = highlights[k] and runs_of(sentences, highlights[k]) or { { from = 1, to = #sentences } }
			local first, last_item
			for r, run in ipairs(runs) do
				local raw = highlights[k] and table.concat(sentences, " ", run.from, run.to) or piece
				local shown, notes = text.render(raw)
				local space
				if r < #runs then
					space = 2
				else
					space = i == #pieces and GAP + 8 or 6
				end
				local on_tap = function()
					local here = run.mark or bookmarks.in_section(self.store.values, part_n, section_n)[k]
					if #notes > 0 or here then
						show_notes(self, section, notes, here)
					end
				end
				local item
				if run.mark then
					item = add_highlighted(self, shown, { space_after = space + 4, space_before = r > 1 and 4 or 0,
						on_tap = on_tap })
				else
					item = add(self, shown, { space_after = space, on_tap = on_tap })
				end
				item.chunk, item.run = k, run
				first = first or item
				last_item = item
			end
			local shown_all = text.render(piece)
			self.chunks[k] = { top = first.top, height = first.top - (last_item.top - last_item.height),
				shown = shown_all, sentences = sentences }
			if marks[k] then
				mark_bar(self, first, self.chunks[k].height)
			end
		end
	end
	if section_n < #part.sections then
		add(self, "Next section ›", { color = self.colors.accent, space_before = 20,
			on_tap = function() show_section(self, part_n, section_n + 1) end })
	elseif part_n < #self.book:index().parts then
		local next_part = self.book:index().parts[part_n + 1]
		add(self, next_part.name .. " ›", { color = self.colors.accent, space_before = 20,
			on_tap = function() show_section(self, part_n + 1, 1) end })
	end
	local target = chunk and self.chunks[chunk]
	set_scroll(self, target and (-target.top - 16) or 0)
	remember(self)
	update_banner(self)
end

-- A part's sections, grouped by sub-part. When the part has several
-- sub-parts, a list of them at the top jumps to each group. `focus` scrolls
-- to a section (coming back from it).
show_part = function(self, part_n, focus)
	close_notes(self)
	local part = self.book:part(part_n)
	self.view, self.part_n = "part", part_n
	clear(self)
	set_header(self, "Contents", part.name)
	local subs, seen = {}, {}
	for _, section in ipairs(part.sections) do
		if section.sub and not seen[section.sub] then
			seen[section.sub] = true
			subs[#subs + 1] = section.sub
		end
	end
	local headings = {}
	if #subs > 1 then
		for _, sub in ipairs(subs) do
			add(self, sub .. " ›", { color = self.colors.accent, scale = 0.85, space_after = 8,
				on_tap = function() set_scroll(self, -headings[sub].top - 10) end })
		end
		add(self, "", { space_after = 10 })
	end
	local current_sub
	local rows = {}
	for i, section in ipairs(part.sections) do
		if section.sub and section.sub ~= current_sub then
			current_sub = section.sub
			headings[section.sub] = add(self, section.sub, { color = self.colors.muted,
				space_before = 16, space_after = 12 })
		end
		rows[i] = add(self, "Section " .. section.label, { indent = 24, space_after = 16,
			on_tap = function() show_section(self, part_n, i) end })
	end
	set_scroll(self, focus and rows[focus] and (-rows[focus].top - viewport_h(self) / 3) or 0)
	update_banner(self)
end

show_contents = function(self)
	close_notes(self)
	local index = self.book:index()
	self.view = "contents"
	clear(self)
	set_header(self, self.owner and "Back" or nil, index.title or "")
	if index.translator then
		add(self, index.translator, { color = self.colors.muted, space_after = GAP + 10 })
	end
	local st = self.store.values
	local last = st.last
	if last and index.parts[last.part] then
		local section = self.book:section(last.part, last.section)
		if section then
			add(self, string.format("Continue: %s, section %s ›", index.parts[last.part].name, section.label), {
				color = self.colors.accent, space_after = 14,
				on_tap = function() show_section(self, last.part, last.section, last.chunk) end,
			})
		end
	end
	if st.marks and #st.marks > 0 then
		add(self, string.format("Bookmarks & highlights (%d) ›", #st.marks), { color = self.colors.accent,
			space_after = 14, on_tap = function() show_marks(self) end })
	end
	if last or (st.marks and #st.marks > 0) then
		add(self, "", { space_after = 8 })
	end
	for n, entry in ipairs(index.parts) do
		local open_part = function() show_part(self, n) end
		add(self, string.format("%d   %s", entry.number or n, entry.name), {
			space_after = 4, on_tap = open_part,
		})
		add(self, string.format("%d sections", entry.sections), { color = self.colors.muted,
			indent = 44, scale = 0.8, space_after = GAP, on_tap = open_part })
	end
	set_scroll(self, 0)
end

local FILTER_LABELS = { all = "All", highlight = "Highlights", bookmark = "Bookmarks", annotated = "With notes" }

local function export_marks(self)
	local index = self.book:index()
	local app_id = sys.get_config_string("reader.save_id", "reader")
	local file = app_id .. "-marks-" .. notes_export.date() .. ".txt"
	local txt = notes_export.text((index.title or "The book") .. ": my highlights and bookmarks",
		{ { heading = "Highlights and bookmarks, in book order", entries = bookmarks.export_entries(self.store.values) } })
	local path, shared = notes_export.export(app_id, file, txt)
	return path and (shared and ("Exported: " .. file) or ("Saved as " .. file)) or "Could not save the file"
end

-- The growing list of marks, in book order, with filters.
show_marks = function(self, status)
	close_notes(self)
	self.view = "marks"
	clear(self)
	set_header(self, "Contents", "Marks")
	local st = self.store.values
	local which = self.marks_filter or "all"
	local filters = {}
	for _, f in ipairs(bookmarks.FILTERS) do
		filters[#filters + 1] = { string.format("%s (%d)", FILTER_LABELS[f], bookmarks.count(st, f)),
			function()
				self.marks_filter = f
				show_marks(self)
			end, f == which and self.colors.ink or self.colors.accent }
	end
	add_inline(self, { filters[1], filters[2] }, { scale = 0.85, space_after = 8 })
	add_inline(self, { filters[3], filters[4] }, { scale = 0.85, space_after = GAP })
	if #(st.marks or {}) > 0 then
		add(self, status or "Export as a text file (.txt) ›", { color = status and self.colors.muted or self.colors.accent,
			scale = 0.85, space_after = GAP + 10,
			on_tap = function() show_marks(self, export_marks(self)) end })
	end
	local list = bookmarks.filter(st, which)
	if #list == 0 then
		add(self, "Nothing here yet. In a section, press and hold a paragraph to highlight sentences, "
			.. "or tap “Bookmark” to mark the paragraph at the top of the screen.", { color = self.colors.muted })
	end
	local title = self.book:index().title
	for _, m in ipairs(list) do
		local open = function() show_section(self, m.part, m.section, m.chunk) end
		local is_highlight = bookmarks.kind(m) == "highlight"
		add(self, (is_highlight and "" or "Bookmark · ") .. (m.place or place_of(self, m.part, m.section)),
			{ color = self.colors.accent, scale = 0.8, space_after = 8, on_tap = open })
		if is_highlight then
			add_highlighted(self, "“" .. (m.quote or "") .. "”", { scale = 0.9, space_after = 10, on_tap = open })
		else
			add(self, "“" .. (m.excerpt or "") .. "”", { color = self.colors.muted, scale = 0.85,
				space_after = 8, on_tap = open })
		end
		if (m.note or "") ~= "" then
			add(self, m.note, { space_after = 8, on_tap = function() self.open_editor(self, m) end })
		end
		local actions = { { (m.note or "") ~= "" and "Edit note" or "Add a note", function() self.open_editor(self, m) end } }
		if is_highlight then
			actions[#actions + 1] = { "Share", function() share.to_whatsapp(bookmarks.share_text(m, title)) end }
		end
		local remove
		actions[#actions + 1] = { "Remove", function()
			if remove.armed then
				bookmarks.remove(st, bookmarks.index_of(st, m))
				self.store:write()
				show_marks(self)
			else
				remove.armed = true
				gui.set_text(remove.node, "Tap again to remove")
			end
		end, self.colors.muted }
		local items = add_inline(self, actions, { scale = 0.8, space_after = GAP + 16 })
		remove = items[#items]
	end
	set_scroll(self, 0)
end

-- The note editor, for a new bookmark (place given) or an existing mark.
local function open_editor(self, mark)
	close_notes(self)
	self.editing = mark
	local is_highlight = bookmarks.kind(mark) == "highlight"
	local shown = is_highlight and bookmarks.excerpt(mark.quote or "", 160) or mark.excerpt
	self.editor = note_editor.open({
		width = self.width, height = self.height, header = HEADER_H, parent = self.root,
		title = is_highlight and "Note" or "Bookmark", prompt = shown and ("“" .. shown .. "”") or nil,
		text = mark.note or "", max = 1000,
		colors = { panel = self.colors.background, field = self.colors.field, ink = self.colors.ink,
			muted = self.colors.muted, accent = self.colors.accent },
	})
end

local function redraw(self)
	if self.view == "section" then
		local chunk = current_chunk(self)
		local scroll = self.scroll
		show_section(self, self.part_n, self.section_n, chunk)
		set_scroll(self, scroll)
	elseif self.view == "marks" then
		local scroll = self.scroll
		show_marks(self)
		set_scroll(self, scroll)
	end
end

local function close_editor(self, keep)
	local mark = self.editing
	local note = note_editor.value(self.editor)
	note_editor.close(self.editor)
	self.editor, self.editing = nil, nil
	if keep then
		mark.note = note
		if bookmarks.kind(mark) == "bookmark" then
			bookmarks.add(self.store.values, mark) -- new, or its note updated
		end
		self.store:write()
	end
	redraw(self)
end

-- Choosing sentences to highlight ---------------------------------------------

local function close_picker(self)
	if self.picker then
		gui.delete_node(self.picker.panel)
		self.picker = nil
	end
end

local function paint_picker(self)
	local p = self.picker
	for i, row in ipairs(p.rows) do
		local selected = p.from and i >= p.from and i <= p.to
		gui.set_color(row.box, selected and self.colors.highlight or self.colors.field)
	end
	gui.set_enabled(p.remove.node, p.existing ~= nil)
end

-- Press and hold on a paragraph: its sentences, to tap and highlight.
local function open_picker(self, k, mark)
	close_notes(self)
	local chunk = self.chunks[k]
	local W, H = self.width, self.height
	local p = { k = k, rows = {}, existing = mark }
	if mark then
		p.from, p.to = mark.from, mark.to
	end
	p.panel = gui.new_box_node(vmath.vector3(W / 2, H / 2, 0), vmath.vector3(W, H, 0))
	gui.set_color(p.panel, self.colors.background)
	gui.set_parent(p.panel, self.root)
	local function label(str, x, y, pivot, color, font, scale)
		local node = gui.new_text_node(vmath.vector3(x - W / 2, y - H / 2, 0), str)
		gui.set_font(node, font or "body")
		gui.set_pivot(node, pivot)
		gui.set_color(node, color)
		if scale then
			gui.set_scale(node, vmath.vector3(scale, scale, 1))
		end
		gui.set_parent(node, p.panel)
		return node
	end
	label("‹ Cancel", MARGIN, H - 40, gui.PIVOT_NW, self.colors.muted)
	label("Highlight", W - MARGIN, H - 40, gui.PIVOT_NE, self.colors.accent)
	label("Highlight", MARGIN, H - 88, gui.PIVOT_NW, self.colors.ink, "title")
	label("Tap the sentences to highlight. Tap the first or last again to shorten.", MARGIN, H - HEADER_H - 14,
		gui.PIVOT_NW, self.colors.muted, "body", 0.75)

	local y = H - HEADER_H - 70
	local width = W - 2 * MARGIN
	local scale = 0.9
	for i, sentence in ipairs(chunk.sentences) do
		local shown = text.render(sentence)
		local h = measure(self, "body", shown, (width - 24) / scale, 1.15).height * scale
		local box = gui.new_box_node(vmath.vector3(MARGIN - 12 - W / 2, y + 8 - H / 2, 0), vmath.vector3(width + 24, h + 16, 0))
		gui.set_pivot(box, gui.PIVOT_NW)
		gui.set_parent(box, p.panel)
		local node = gui.new_text_node(vmath.vector3(12, -8, 0), shown)
		gui.set_font(node, "body")
		gui.set_pivot(node, gui.PIVOT_NW)
		gui.set_line_break(node, true)
		gui.set_size(node, vmath.vector3((width - 24) / scale, 0, 0))
		gui.set_leading(node, 1.15)
		gui.set_scale(node, vmath.vector3(scale, scale, 1))
		gui.set_color(node, self.colors.ink)
		gui.set_parent(node, box)
		p.rows[i] = { box = box, y0 = y - h - 8, y1 = y + 8 }
		y = y - h - 30
	end
	p.note_btn = { node = label("Highlight and add a note ›", MARGIN, y - 10, gui.PIVOT_NW, self.colors.accent),
		y0 = y - 60, y1 = y }
	p.remove = { node = label("Remove this highlight", MARGIN, y - 70, gui.PIVOT_NW, self.colors.muted),
		y0 = y - 120, y1 = y - 60 }
	self.picker = p
	paint_picker(self)
end

local function save_picker(self, with_note)
	local p = self.picker
	local chunk = self.chunks[p.k]
	close_picker(self)
	if not p.from then
		return
	end
	local st = self.store.values
	if p.existing then
		bookmarks.remove(st, bookmarks.index_of(st, p.existing))
	end
	local mark = bookmarks.add_highlight(st, {
		part = self.part_n, section = self.section_n, chunk = p.k, from = p.from, to = p.to,
		place = place_of(self, self.part_n, self.section_n), day = os.time(),
		note = p.existing and p.existing.note or nil,
	}, chunk.sentences)
	st.highlight_tip_seen = true
	self.store:write()
	redraw(self)
	if with_note then
		open_editor(self, mark)
	end
end

local function picker_tap(self, x, y)
	local p = self.picker
	if y > self.height - 90 then
		if x < self.width / 2 then
			close_picker(self)
		else
			save_picker(self, false)
		end
		return
	end
	for i, row in ipairs(p.rows) do
		if y >= row.y0 and y <= row.y1 then
			if not p.from then
				p.from, p.to = i, i
			elseif i < p.from then
				p.from = i
			elseif i > p.to then
				p.to = i
			elseif i == p.from and i == p.to then
				p.from, p.to = nil, nil
			elseif i == p.from then
				p.from = i + 1
			elseif i == p.to then
				p.to = i - 1
			else
				p.from, p.to = i, i
			end
			paint_picker(self)
			return
		end
	end
	if y >= p.note_btn.y0 and y <= p.note_btn.y1 then
		save_picker(self, true)
	elseif p.existing and y >= p.remove.y0 and y <= p.remove.y1 then
		local st = self.store.values
		bookmarks.remove(st, bookmarks.index_of(st, p.existing))
		self.store:write()
		close_picker(self)
		redraw(self)
	end
end

-- "Bookmark": the paragraph at the top of the screen.
local function bookmark_here(self)
	local k = current_chunk(self)
	local item = self.chunks[k]
	if not item then
		return
	end
	local st = self.store.values
	local existing = bookmarks.find(st, self.part_n, self.section_n, k)
	open_editor(self, existing and st.marks[existing] or {
		kind = "bookmark", part = self.part_n, section = self.section_n, chunk = k,
		place = place_of(self, self.part_n, self.section_n),
		excerpt = bookmarks.excerpt(item.shown, 90), note = "", day = os.time(),
	})
end

local function show(self)
	if not self.visible then
		self.visible = true
		gui.set_enabled(self.root, true)
		msg.post(".", "acquire_input_focus")
	end
	update_banner(self)
end

local function hide(self)
	if self.visible then
		remember(self)
		self.visible = false
		self.drag = nil
		gui.set_enabled(self.root, false)
		msg.post(".", "release_input_focus")
	end
	update_banner(self)
end

local function close(self)
	hide(self)
	if self.owner then
		msg.post(self.owner, "reader_closed")
	end
end

local function go_back(self)
	if self.picker then
		close_picker(self)
	elseif self.notes_panel then
		close_notes(self)
	elseif self.view == "section" then
		show_part(self, self.part_n, self.section_n)
	elseif self.view == "part" or self.view == "marks" then
		show_contents(self)
	elseif self.owner then
		close(self)
	else
		return false
	end
	return true
end

-- Lifecycle ------------------------------------------------------------------

function init(self)
	self.font_res = {}
	self.width = tonumber(sys.get_config_string("display.width", "720"))
	self.height = tonumber(sys.get_config_string("display.height", "1280"))
	self.colors = {
		background = config_color("background", "#F3E9D2"),
		ink = config_color("ink", "#2B1D12"),
		accent = config_color("accent", "#8B2E16"),
		muted = config_color("muted", "#7A6A58"),
		field = config_color("field", "#E7D9BA"),
		highlight = config_color("highlight", "#E6BE5C73"),
	}
	self.store = save_mod.open(sys.get_config_string("reader.save_id", "reader"), { marks = {} }, "reader")
	self.open_editor = open_editor

	-- Everything hangs under one root, so the reader can be hidden at once.
	self.root = gui.new_box_node(vmath.vector3(0, 0, 0), vmath.vector3(0, 0, 0))
	local bg = gui.new_box_node(vmath.vector3(self.width / 2, self.height / 2, 0),
		vmath.vector3(self.width, self.height, 0))
	gui.set_color(bg, self.colors.background)
	gui.set_parent(bg, self.root)

	self.header_bg = gui.new_box_node(vmath.vector3(self.width / 2, self.height - HEADER_H / 2, 0),
		vmath.vector3(self.width, HEADER_H, 0))
	gui.set_color(self.header_bg, self.colors.background)
	gui.set_parent(self.header_bg, self.root)
	local rule = gui.new_box_node(vmath.vector3(self.width / 2, self.height - HEADER_H + 1, 0),
		vmath.vector3(self.width - 2 * MARGIN, 2, 0))
	gui.set_color(rule, self.colors.accent)
	gui.set_parent(rule, self.root)

	self.back = gui.new_text_node(vmath.vector3(MARGIN, self.height - 40, 0), "")
	gui.set_font(self.back, "body")
	gui.set_pivot(self.back, gui.PIVOT_NW)
	gui.set_color(self.back, self.colors.accent)
	gui.set_parent(self.back, self.root)
	self.action = gui.new_text_node(vmath.vector3(self.width - MARGIN, self.height - 40, 0), "")
	gui.set_font(self.action, "body")
	gui.set_pivot(self.action, gui.PIVOT_NE)
	gui.set_color(self.action, self.colors.accent)
	gui.set_parent(self.action, self.root)
	self.title = gui.new_text_node(vmath.vector3(MARGIN, self.height - 88, 0), "")
	gui.set_font(self.title, "title")
	gui.set_pivot(self.title, gui.PIVOT_NW)
	gui.set_color(self.title, self.colors.ink)
	gui.set_parent(self.title, self.root)

	self.bottom_bg = gui.new_box_node(vmath.vector3(self.width / 2, 0, 0), vmath.vector3(self.width, 0, 0))
	gui.set_color(self.bottom_bg, self.colors.background)
	gui.set_parent(self.bottom_bg, self.root)
	gui.set_enabled(self.bottom_bg, false)

	-- "Top": a small round button with a chevron (two short bars)
	-- in the header, beside the title, so it never covers the text
	self.top_btn = gui.new_pie_node(vmath.vector3(self.width - MARGIN - 34, self.height - 112, 0),
		vmath.vector3(68, 68, 0))
	gui.set_outer_bounds(self.top_btn, gui.PIEBOUNDS_ELLIPSE)
	gui.set_perimeter_vertices(self.top_btn, 48)
	gui.set_color(self.top_btn, self.colors.accent)
	gui.set_parent(self.top_btn, self.root)
	for side = -1, 1, 2 do
		local bar = gui.new_box_node(vmath.vector3(side * 9, 3, 0), vmath.vector3(26, 5, 0))
		gui.set_rotation(bar, vmath.vector3(0, 0, -side * 40))
		gui.set_color(bar, self.colors.background)
		gui.set_parent(bar, self.top_btn)
	end
	self.bottom = 0
	set_bottom(self, 0)
	ads.set_banner_listener(function(px)
		set_bottom(self, pixels_to_units(self, px))
	end)
	-- Desktop test of the layout: pretend a banner of this many pixels shows.
	local test_px = sys.get_config_int("reader.test_banner_px", 0)
	if test_px > 0 then
		self.test_banner_px = test_px
	end

	self.book = reader.open(sys.get_config_string("reader.book_dir", "/shared/reader/data/"))
	show_contents(self)
	self.visible = false
	if sys.get_config_int("reader.start_hidden", 0) == 1 then
		gui.set_enabled(self.root, false)
	else
		self.visible = true
		msg.post(".", "acquire_input_focus")
	end

	-- Optional start position, e.g. "3" or "3,281", for testing and deep links.
	local open = sys.get_config_string("reader.open", "")
	local p, s = open:match("^(%d+),?(%d*)$")
	if p then
		if s ~= "" then
			show_section(self, tonumber(p), tonumber(s))
		else
			show_part(self, tonumber(p))
		end
	end
end

-- The item under a point of the screen, if it can be tapped.
local function item_at(self, x, y)
	local cy = y - (self.height - HEADER_H) - self.scroll
	for _, item in ipairs(self.items) do
		if item.on_tap and cy <= item.top + 8 and cy >= item.top - item.height - 8
			and (not item.x0 or (x >= item.x0 and x <= item.x1)) then
			return item
		end
	end
end

local function tap(self, x, y)
	if self.picker then
		picker_tap(self, x, y)
		return
	end
	if self.notes_panel then
		close_notes(self)
		return
	end
	if self.top_shown then
		local p = gui.get_position(self.top_btn)
		-- kept clear of "Bookmark" just above it
		if math.abs(x - p.x) < 50 and math.abs(y - p.y) < 36 then
			set_scroll(self, 0)
			return
		end
	end
	if y < (self.bottom or 0) then
		return -- the banner's space
	end
	if y > self.height - HEADER_H then
		if self.back_enabled and y > self.height - 90 and x < self.width / 2 then
			go_back(self)
		elseif self.action_enabled and y > self.height - 90 and x > self.width / 2 then
			bookmark_here(self)
		end
		return
	end
	local item = item_at(self, x, y)
	if item then
		item.on_tap()
	end
end

-- Press and hold on a paragraph of a section: choose sentences to highlight.
local function hold(self, x, y)
	if self.view ~= "section" or self.picker or self.notes_panel or y < (self.bottom or 0)
		or y > self.height - HEADER_H then
		return
	end
	local item = item_at(self, x, y)
	if item and item.chunk then
		open_picker(self, item.chunk, item.run and item.run.mark)
	end
end

function on_input(self, action_id, action)
	if not self.visible then
		return false
	end
	if self.editor then
		local result = note_editor.on_input(self.editor, action_id, action)
		if result then
			close_editor(self, result == "done")
		end
		return true
	end
	if action_id == TOUCH then
		-- A quick tap can arrive as pressed and released in the same frame.
		if action.pressed then
			self.drag = { last = action.y, moved = 0, x = action.x, y = action.y, held = 0 }
		end
		if action.released then
			if self.drag and self.drag.done then
				-- the press-and-hold already acted
			elseif self.drag and self.drag.moved < TAP_SLOP then
				tap(self, action.x, action.y)
			elseif self.drag then
				remember(self)
			end
			self.drag = nil
		elseif not action.pressed and self.drag then
			local dy = action.y - self.drag.last
			self.drag.last = action.y
			self.drag.moved = self.drag.moved + math.abs(dy)
			if self.drag.moved >= TAP_SLOP and not self.notes_panel and not self.picker then
				set_scroll(self, self.scroll + dy)
			end
		end
		return true
	elseif action_id == nil and self.drag then
		-- pointer moved while pressed (desktop)
		local dy = action.y - self.drag.last
		self.drag.last = action.y
		self.drag.moved = self.drag.moved + math.abs(dy)
		if self.drag.moved >= TAP_SLOP and not self.notes_panel and not self.picker then
			set_scroll(self, self.scroll + dy)
		end
		return true
	elseif action_id == WHEEL_UP and action.pressed then
		set_scroll(self, self.scroll - 90)
		remember(self)
		return true
	elseif action_id == WHEEL_DOWN and action.pressed then
		set_scroll(self, self.scroll + 90)
		remember(self)
		return true
	elseif action_id == BACK and action.released then
		return go_back(self)
	end
end

function update(self, dt)
	if self.editor then
		note_editor.update(self.editor, dt)
	end
	local d = self.drag
	if d and not d.done and d.moved < TAP_SLOP then
		d.held = d.held + dt
		if d.held >= HOLD then
			d.done = true
			hold(self, d.x, d.y)
		end
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("open") then
		-- msg.post("reader:/reader#gui", "open", { part = 3, section = 281 })
		self.owner = sender
		show(self)
		if message.section then
			show_section(self, message.part, message.section)
		elseif message.part then
			show_part(self, message.part)
		else
			show_contents(self)
		end
	elseif message_id == hash("close") then
		close(self)
	end
end
