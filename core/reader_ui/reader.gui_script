-- The reader screen: contents -> a part's sections -> the text of a section.
--
-- Settings, in the app's game.project:
--   [reader]
--   book_dir = /shared/reader/data/      where the book's JSON lives
--   open = 3,281                         optional: open a part (and section) at start
--   background = #F3E9D2                 optional colours (hex)
--   ink = #2B1D12
--   accent = #8B2E16
--   muted = #7A6A58
--
-- Drag to scroll, tap to open. In the text, footnote numbers are shown as
-- superscripts; tapping a paragraph that has notes shows them. The Android
-- back key (or the ‹ link in the header) goes back up a level.
--
-- The reader remembers where the player stopped ("Continue" on the
-- contents) and keeps bookmarks with notes: "Bookmark" in a section's
-- header marks the paragraph at the top of the screen and asks for an
-- optional note; marked paragraphs have a bar in the margin, and tapping
-- one shows its note. Both are stored on the phone, in the app's save
-- folder (reader.save_id, default "reader"), in a file named "reader".
--
-- Long sections are cut into chunks at sentence ends, and only the chunks on
-- screen are drawn, so even the longest sections stay light on cheap phones.
--
-- Inside a game: set reader.start_hidden = 1 and open it with
--   msg.post("reader:/reader#gui", "open", { part = 3, section = 311 })
-- (or with no part for the contents). The sender becomes its owner: the
-- contents then get a "‹ Back" link, and going back from the contents (or
-- the "close" message) hides the reader and sends "reader_closed" to the
-- owner. While hidden it draws nothing and takes no input.

local reader = require "core.reader"
local text = require "core.reader_ui.text"
local save_mod = require "core.save"
local bookmarks = require "core.bookmarks"
local note_editor = require "core.ui.note_editor"
local notes_export = require "core.notes_export"

local TOUCH = hash("mouse_button_left")
local BACK = hash("key_back")
local WHEEL_UP = hash("mouse_wheel_up")
local WHEEL_DOWN = hash("mouse_wheel_down")

local MARGIN = 44
local HEADER_H = 170
local GAP = 22
local TAP_SLOP = 14

local function config_color(key, default)
	return text.color(sys.get_config_string("reader." .. key, default))
end

-- Layout ---------------------------------------------------------------------

-- Text size, measured with the font resource (Defold 1.13 has no
-- gui.get_text_metrics_from_node).
local function measure(self, font, str, width, leading, line_break)
	self.font_res[font] = self.font_res[font] or gui.get_font_resource(font)
	return resource.get_text_metrics(self.font_res[font], str,
		{ width = width, leading = leading or 1, line_break = line_break ~= false })
end

local function new_text(self, str, font, color, width, scale)
	local node = gui.new_text_node(vmath.vector3(0, 0, 0), str)
	gui.set_font(node, font)
	gui.set_pivot(node, gui.PIVOT_NW)
	gui.set_line_break(node, true)
	gui.set_size(node, vmath.vector3(width / (scale or 1), 0, 0))
	gui.set_color(node, color)
	gui.set_leading(node, 1.15)
	if scale then
		gui.set_scale(node, vmath.vector3(scale, scale, 1))
	end
	gui.set_parent(node, self.content)
	local metrics = measure(self, font, str, width / (scale or 1), 1.15)
	return node, metrics.height * (scale or 1)
end

-- Adds an item below the previous ones. on_tap is optional.
local function add(self, str, opts)
	opts = opts or {}
	local width = self.width - 2 * MARGIN - (opts.indent or 0)
	local node, h = new_text(self, str, opts.font or "body", opts.color or self.colors.ink, width, opts.scale)
	local top = -self.cursor - (opts.space_before or 0)
	gui.set_position(node, vmath.vector3(MARGIN + (opts.indent or 0), top, 0))
	local item = { node = node, top = top, height = h, on_tap = opts.on_tap }
	self.items[#self.items + 1] = item
	self.cursor = -top + h + (opts.space_after or GAP)
	return item
end

local function viewport_h(self)
	return self.height - HEADER_H
end

local function max_scroll(self)
	return math.max(0, self.cursor + 60 - viewport_h(self))
end

-- Shows only the items that are on screen (or nearly).
local function cull(self)
	local view = viewport_h(self)
	for _, item in ipairs(self.items) do
		local top = item.top + self.scroll -- 0 = top of viewport, negative = below
		local visible = top > -view - 400 and top - item.height < 400
		if visible ~= item.enabled then
			gui.set_enabled(item.node, visible)
			item.enabled = visible
		end
	end
end

local function set_scroll(self, value)
	self.scroll = math.max(0, math.min(max_scroll(self), value))
	gui.set_position(self.content, vmath.vector3(0, self.height - HEADER_H + self.scroll, 0))
	cull(self)
end

local function clear(self)
	if self.content then
		gui.delete_node(self.content)
	end
	self.content = gui.new_box_node(vmath.vector3(0, 0, 0), vmath.vector3(0, 0, 0))
	gui.set_parent(self.content, self.root)
	gui.move_below(self.content, self.header_bg)
	self.items = {}
	self.chunks = nil
	self.cursor = 24
	self.scroll = 0
	set_scroll(self, 0)
end

local function set_header(self, back_label, title, action_label)
	gui.set_text(self.back, back_label and ("‹ " .. back_label) or "")
	gui.set_text(self.action, action_label or "")
	self.action_enabled = action_label ~= nil
	gui.set_text(self.title, title)
	-- Long titles shrink to fit on one line.
	gui.set_scale(self.title, vmath.vector3(1, 1, 1))
	local w = measure(self, "title", title, 0, 1, false).width
	local room = self.width - 2 * MARGIN
	if w > room then
		local s = room / w
		gui.set_scale(self.title, vmath.vector3(s, s, 1))
	end
	self.back_enabled = back_label ~= nil
end

-- Views ----------------------------------------------------------------------

local show_contents, show_part, show_section, show_marks

-- Where reading stands: the first paragraph (chunk) with a real part of it
-- still on screen (not just its last line).
local function current_chunk(self)
	for k, item in ipairs(self.chunks or {}) do
		if item.top - item.height < -self.scroll - math.min(90, item.height / 2) then
			return k
		end
	end
	return 1
end

-- Saves the reading position (in a section only).
local function remember(self)
	if self.view == "section" then
		bookmarks.set_last(self.store.values, self.part_n, self.section_n, current_chunk(self))
		self.store:write()
	end
end

local function close_notes(self)
	if self.notes_panel then
		gui.delete_node(self.notes_panel)
		self.notes_panel = nil
	end
end

local function show_notes(self, section, nums, mark)
	close_notes(self)
	local panel = gui.new_box_node(vmath.vector3(self.width / 2, self.height / 2, 0),
		vmath.vector3(self.width, self.height, 0))
	gui.set_color(panel, vmath.vector4(0, 0, 0, 0.55))
	gui.set_parent(panel, self.root)
	gui.set_inherit_alpha(panel, false)
	local body = {}
	if mark then
		body[1] = (mark.note or "") ~= "" and ("Your note: " .. mark.note) or "Bookmarked."
	end
	for _, num in ipairs(nums or {}) do
		body[#body + 1] = text.superscript(num) .. " " .. (section.notes[num] or "")
	end
	local width = self.width - 2 * MARGIN - 40
	local node = gui.new_text_node(vmath.vector3(0, 0, 0), table.concat(body, "\n\n"))
	gui.set_font(node, "body")
	gui.set_line_break(node, true)
	gui.set_size(node, vmath.vector3(width, 0, 0))
	gui.set_leading(node, 1.15)
	gui.set_color(node, self.colors.ink)
	gui.set_inherit_alpha(node, false)
	local h = measure(self, "body", table.concat(body, "\n\n"), width, 1.15).height
	local card = gui.new_box_node(vmath.vector3(0, 0, 0), vmath.vector3(width + 60, h + 60, 0))
	gui.set_color(card, self.colors.background)
	gui.set_inherit_alpha(card, false)
	gui.set_parent(card, panel)
	gui.set_pivot(node, gui.PIVOT_NW)
	gui.set_position(node, vmath.vector3(-width / 2, h / 2, 0))
	gui.set_parent(node, card)
	self.notes_panel = panel
end

-- A bar in the margin beside a bookmarked paragraph.
local function mark_bar(self, item)
	local bar = gui.new_box_node(vmath.vector3(-18, 0, 0), vmath.vector3(5, item.height, 0))
	gui.set_pivot(bar, gui.PIVOT_N)
	gui.set_color(bar, self.colors.accent)
	gui.set_parent(bar, item.node)
	item.bar = bar
end

show_section = function(self, part_n, section_n, chunk)
	close_notes(self)
	local part = self.book:part(part_n)
	local section = part.sections[section_n]
	self.view, self.part_n, self.section_n = "section", part_n, section_n
	clear(self)
	set_header(self, part.name, "Section " .. section.label, "Bookmark")
	if section.sub then
		add(self, section.sub, { color = self.colors.muted, space_after = GAP + 6 })
	end
	local marks = bookmarks.in_section(self.store.values, part_n, section_n)
	local n = 0
	self.chunks = {}
	for _, para in ipairs(section.paras) do
		local pieces = text.chunks(para, 700)
		for i, piece in ipairs(pieces) do
			n = n + 1
			local shown, notes = text.render(piece)
			local last = i == #pieces
			local k = n
			local item = add(self, shown, {
				space_after = last and GAP + 8 or 6,
				on_tap = function()
					local mark = bookmarks.in_section(self.store.values, part_n, section_n)[k]
					if #notes > 0 or mark then
						show_notes(self, section, notes, mark)
					end
				end,
			})
			item.chunk, item.shown = k, shown
			self.chunks[k] = item
			if marks[k] then
				mark_bar(self, item)
			end
		end
	end
	if section_n < #part.sections then
		add(self, "Next section ›", { color = self.colors.accent, space_before = 20,
			on_tap = function() show_section(self, part_n, section_n + 1) end })
	elseif part_n < #self.book:index().parts then
		local next_part = self.book:index().parts[part_n + 1]
		add(self, next_part.name .. " ›", { color = self.colors.accent, space_before = 20,
			on_tap = function() show_section(self, part_n + 1, 1) end })
	end
	local target = chunk and self.chunks[chunk]
	set_scroll(self, target and (-target.top - 16) or 0)
	remember(self)
end

-- A part's sections, grouped by sub-part. When the part has several
-- sub-parts, a list of them at the top jumps to each group. `focus` scrolls
-- to a section (coming back from it).
show_part = function(self, part_n, focus)
	close_notes(self)
	local part = self.book:part(part_n)
	self.view, self.part_n = "part", part_n
	clear(self)
	set_header(self, "Contents", part.name)
	local subs, seen = {}, {}
	for _, section in ipairs(part.sections) do
		if section.sub and not seen[section.sub] then
			seen[section.sub] = true
			subs[#subs + 1] = section.sub
		end
	end
	local headings = {}
	if #subs > 1 then
		for _, sub in ipairs(subs) do
			add(self, sub .. " ›", { color = self.colors.accent, scale = 0.85, space_after = 8,
				on_tap = function() set_scroll(self, -headings[sub].top - 10) end })
		end
		add(self, "", { space_after = 10 })
	end
	local current_sub
	local rows = {}
	for i, section in ipairs(part.sections) do
		if section.sub and section.sub ~= current_sub then
			current_sub = section.sub
			headings[section.sub] = add(self, section.sub, { color = self.colors.muted,
				space_before = 16, space_after = 12 })
		end
		rows[i] = add(self, "Section " .. section.label, { indent = 24, space_after = 16,
			on_tap = function() show_section(self, part_n, i) end })
	end
	set_scroll(self, focus and rows[focus] and (-rows[focus].top - viewport_h(self) / 3) or 0)
end

show_contents = function(self)
	close_notes(self)
	local index = self.book:index()
	self.view = "contents"
	clear(self)
	set_header(self, self.owner and "Back" or nil, index.title or "")
	if index.translator then
		add(self, index.translator, { color = self.colors.muted, space_after = GAP + 10 })
	end
	local st = self.store.values
	local last = st.last
	if last and index.parts[last.part] then
		local section = self.book:section(last.part, last.section)
		if section then
			add(self, string.format("Continue: %s, section %s ›", index.parts[last.part].name, section.label), {
				color = self.colors.accent, space_after = 14,
				on_tap = function() show_section(self, last.part, last.section, last.chunk) end,
			})
		end
	end
	if st.marks and #st.marks > 0 then
		add(self, string.format("Bookmarks (%d) ›", #st.marks), { color = self.colors.accent,
			space_after = 14, on_tap = function() show_marks(self) end })
	end
	if last or (st.marks and #st.marks > 0) then
		add(self, "", { space_after = 8 })
	end
	for n, entry in ipairs(index.parts) do
		local open_part = function() show_part(self, n) end
		add(self, string.format("%d   %s", entry.number or n, entry.name), {
			space_after = 4, on_tap = open_part,
		})
		add(self, string.format("%d sections", entry.sections), { color = self.colors.muted,
			indent = 44, scale = 0.8, space_after = GAP, on_tap = open_part })
	end
	set_scroll(self, 0)
end

-- The list of bookmarks, in book order.
show_marks = function(self)
	close_notes(self)
	self.view = "marks"
	clear(self)
	set_header(self, "Contents", "Bookmarks")
	local marks = self.store.values.marks
	if #marks == 0 then
		add(self, "No bookmarks yet. In a section, tap “Bookmark” to mark the paragraph at the top of the screen.",
			{ color = self.colors.muted })
	end
	local index = self.book:index()
	if #marks > 0 then
		local status
		status = add(self, "Export notes (.txt)", { color = self.colors.accent, space_after = GAP + 10,
			on_tap = function()
				local app_id = sys.get_config_string("reader.save_id", "reader")
				local file = app_id .. "-bookmarks-" .. notes_export.date() .. ".txt"
				local txt = notes_export.text((index.title or "Bookmarks") .. ": my bookmarks",
					{ { heading = "Bookmarks", entries = bookmarks.export_entries(self.store.values) } })
				local path, shared = notes_export.export(app_id, file, txt)
				gui.set_text(status.node, path and (shared and "Exported: " .. file
					or "Saved as " .. file) or "Could not save the file")
			end })
	end
	for i, m in ipairs(marks) do
		local open = function() show_section(self, m.part, m.section, m.chunk) end
		local section = self.book:section(m.part, m.section)
		add(self, string.format("%s  ·  Section %s", index.parts[m.part].name, section and section.label or "?"),
			{ color = self.colors.accent, space_after = 4, on_tap = open })
		add(self, "“" .. (m.excerpt or "") .. "”", { color = self.colors.muted, scale = 0.85,
			space_after = 6, on_tap = open })
		if m.note and m.note ~= "" then
			add(self, m.note, { space_after = 6, on_tap = open })
		end
		add(self, (m.note or "") ~= "" and "Edit note" or "Add a note", { color = self.colors.accent, scale = 0.8,
			indent = 0, space_after = 4, on_tap = function() self.open_editor(self, m) end })
		local remove
		remove = add(self, "Remove", { color = self.colors.muted, scale = 0.8, space_after = GAP + 12,
			on_tap = function()
				if remove.armed then
					bookmarks.remove(self.store.values, i)
					self.store:write()
					show_marks(self)
				else
					remove.armed = true
					gui.set_text(remove.node, "Tap again to remove")
				end
			end })
	end
	set_scroll(self, 0)
end

-- The note editor, for a new bookmark (place given) or an existing one.
local function open_editor(self, mark)
	close_notes(self)
	self.editing = mark
	self.editor = note_editor.open({
		width = self.width, height = self.height, header = HEADER_H, parent = self.root,
		title = "Bookmark", prompt = mark.excerpt and ("“" .. mark.excerpt .. "”") or nil,
		text = mark.note or "", max = 300,
		colors = { panel = self.colors.background, field = self.colors.field, ink = self.colors.ink,
			muted = self.colors.muted, accent = self.colors.accent },
	})
end

local function close_editor(self, keep)
	local mark = self.editing
	local note = note_editor.value(self.editor)
	note_editor.close(self.editor)
	self.editor, self.editing = nil, nil
	if keep then
		mark.note = note
		bookmarks.add(self.store.values, mark)
		self.store:write()
	end
	-- redraw, keeping the place
	if self.view == "section" then
		local chunk = current_chunk(self)
		local scroll = self.scroll
		show_section(self, self.part_n, self.section_n, chunk)
		set_scroll(self, scroll)
	elseif self.view == "marks" then
		show_marks(self)
	end
end

-- "Bookmark": the paragraph at the top of the screen.
local function bookmark_here(self)
	local k = current_chunk(self)
	local item = self.chunks[k]
	if not item then
		return
	end
	local st = self.store.values
	local existing = bookmarks.find(st, self.part_n, self.section_n, k)
	local part = self.book:part(self.part_n)
	open_editor(self, existing and st.marks[existing] or {
		part = self.part_n, section = self.section_n, chunk = k,
		place = part.name .. " · Section " .. part.sections[self.section_n].label,
		excerpt = bookmarks.excerpt(item.shown, 90), note = "", day = os.time(),
	})
end

local function show(self)
	if not self.visible then
		self.visible = true
		gui.set_enabled(self.root, true)
		msg.post(".", "acquire_input_focus")
	end
end

local function hide(self)
	if self.visible then
		remember(self)
		self.visible = false
		self.drag = nil
		gui.set_enabled(self.root, false)
		msg.post(".", "release_input_focus")
	end
end

local function close(self)
	hide(self)
	if self.owner then
		msg.post(self.owner, "reader_closed")
	end
end

local function go_back(self)
	if self.notes_panel then
		close_notes(self)
	elseif self.view == "section" then
		show_part(self, self.part_n, self.section_n)
	elseif self.view == "part" or self.view == "marks" then
		show_contents(self)
	elseif self.owner then
		close(self)
	else
		return false
	end
	return true
end

-- Lifecycle ------------------------------------------------------------------

function init(self)
	self.font_res = {}
	self.width = tonumber(sys.get_config_string("display.width", "720"))
	self.height = tonumber(sys.get_config_string("display.height", "1280"))
	self.colors = {
		background = config_color("background", "#F3E9D2"),
		ink = config_color("ink", "#2B1D12"),
		accent = config_color("accent", "#8B2E16"),
		muted = config_color("muted", "#7A6A58"),
		field = config_color("field", "#E7D9BA"),
	}
	self.store = save_mod.open(sys.get_config_string("reader.save_id", "reader"), { marks = {} }, "reader")
	self.open_editor = open_editor

	-- Everything hangs under one root, so the reader can be hidden at once.
	self.root = gui.new_box_node(vmath.vector3(0, 0, 0), vmath.vector3(0, 0, 0))
	local bg = gui.new_box_node(vmath.vector3(self.width / 2, self.height / 2, 0),
		vmath.vector3(self.width, self.height, 0))
	gui.set_color(bg, self.colors.background)
	gui.set_parent(bg, self.root)

	self.header_bg = gui.new_box_node(vmath.vector3(self.width / 2, self.height - HEADER_H / 2, 0),
		vmath.vector3(self.width, HEADER_H, 0))
	gui.set_color(self.header_bg, self.colors.background)
	gui.set_parent(self.header_bg, self.root)
	local rule = gui.new_box_node(vmath.vector3(self.width / 2, self.height - HEADER_H + 1, 0),
		vmath.vector3(self.width - 2 * MARGIN, 2, 0))
	gui.set_color(rule, self.colors.accent)
	gui.set_parent(rule, self.root)

	self.back = gui.new_text_node(vmath.vector3(MARGIN, self.height - 40, 0), "")
	gui.set_font(self.back, "body")
	gui.set_pivot(self.back, gui.PIVOT_NW)
	gui.set_color(self.back, self.colors.accent)
	gui.set_parent(self.back, self.root)
	self.action = gui.new_text_node(vmath.vector3(self.width - MARGIN, self.height - 40, 0), "")
	gui.set_font(self.action, "body")
	gui.set_pivot(self.action, gui.PIVOT_NE)
	gui.set_color(self.action, self.colors.accent)
	gui.set_parent(self.action, self.root)
	self.title = gui.new_text_node(vmath.vector3(MARGIN, self.height - 88, 0), "")
	gui.set_font(self.title, "title")
	gui.set_pivot(self.title, gui.PIVOT_NW)
	gui.set_color(self.title, self.colors.ink)
	gui.set_parent(self.title, self.root)

	self.book = reader.open(sys.get_config_string("reader.book_dir", "/shared/reader/data/"))
	show_contents(self)
	self.visible = false
	if sys.get_config_int("reader.start_hidden", 0) == 1 then
		gui.set_enabled(self.root, false)
	else
		self.visible = true
		msg.post(".", "acquire_input_focus")
	end

	-- Optional start position, e.g. "3" or "3,281", for testing and deep links.
	local open = sys.get_config_string("reader.open", "")
	local p, s = open:match("^(%d+),?(%d*)$")
	if p then
		if s ~= "" then
			show_section(self, tonumber(p), tonumber(s))
		else
			show_part(self, tonumber(p))
		end
	end
end

local function tap(self, x, y)
	if self.notes_panel then
		close_notes(self)
		return
	end
	if y > self.height - HEADER_H then
		if self.back_enabled and y > self.height - 90 and x < self.width / 2 then
			go_back(self)
		elseif self.action_enabled and y > self.height - 90 and x > self.width / 2 then
			bookmark_here(self)
		end
		return
	end
	-- y in content coordinates: 0 at the top of the content, negative below
	local cy = y - (self.height - HEADER_H) - self.scroll
	for _, item in ipairs(self.items) do
		if item.on_tap and cy <= item.top + 8 and cy >= item.top - item.height - 8 then
			item.on_tap()
			return
		end
	end
end

function on_input(self, action_id, action)
	if not self.visible then
		return false
	end
	if self.editor then
		local result = note_editor.on_input(self.editor, action_id, action)
		if result then
			close_editor(self, result == "done")
		end
		return true
	end
	if action_id == TOUCH then
		-- A quick tap can arrive as pressed and released in the same frame.
		if action.pressed then
			self.drag = { last = action.y, moved = 0 }
		end
		if action.released then
			if self.drag and self.drag.moved < TAP_SLOP then
				tap(self, action.x, action.y)
			elseif self.drag then
				remember(self)
			end
			self.drag = nil
		elseif not action.pressed and self.drag then
			local dy = action.y - self.drag.last
			self.drag.last = action.y
			self.drag.moved = self.drag.moved + math.abs(dy)
			if self.drag.moved >= TAP_SLOP and not self.notes_panel then
				set_scroll(self, self.scroll + dy)
			end
		end
		return true
	elseif action_id == nil and self.drag then
		-- pointer moved while pressed (desktop)
		local dy = action.y - self.drag.last
		self.drag.last = action.y
		self.drag.moved = self.drag.moved + math.abs(dy)
		if self.drag.moved >= TAP_SLOP and not self.notes_panel then
			set_scroll(self, self.scroll + dy)
		end
		return true
	elseif action_id == WHEEL_UP and action.pressed then
		set_scroll(self, self.scroll - 90)
		remember(self)
		return true
	elseif action_id == WHEEL_DOWN and action.pressed then
		set_scroll(self, self.scroll + 90)
		remember(self)
		return true
	elseif action_id == BACK and action.released then
		return go_back(self)
	end
end

function update(self, dt)
	if self.editor then
		note_editor.update(self.editor, dt)
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("open") then
		-- msg.post("reader:/reader#gui", "open", { part = 3, section = 281 })
		self.owner = sender
		show(self)
		if message.section then
			show_section(self, message.part, message.section)
		elseif message.part then
			show_part(self, message.part)
		else
			show_contents(self)
		end
	elseif message_id == hash("close") then
		close(self)
	end
end
